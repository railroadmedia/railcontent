{
    "engines": {
        "node": ">=16.0.0"
    },
    "private": true,
    "scripts": {
        "platform-development": "mix --mix-config=resources/platform/webpack.mix.js",
        "platform-production": " npx mix --mix-config=resources/platform/webpack.mix.js --production",
        "platform-watch": "npx mix --mix-config=resources/platform/webpack.mix.js watch",
        "platform-watch-poll": "mix --mix-config=resources/platform/webpack.mix.js watch -- --watch-options-poll=1000",
        "platform-hot": "mix --mix-config=resources/platform/webpack.mix.js watch --hot",
        "pd": "mix --mix-config=resources/platform/webpack.mix.js",
        "pp": "npx mix --mix-config=resources/platform/webpack.mix.js --production",
        "pw": "npx mix --mix-config=resources/platform/webpack.mix.js watch",
        "marketing-development": "mix --mix-config=resources/marketing/webpack.mix.js",
        "marketing-production": "mix --mix-config=resources/marketing/webpack.mix.js --production",
        "marketing-watch": "mix --mix-config=resources/marketing/webpack.mix.js watch",
        "marketing-watch-poll": "mix --mix-config=resources/marketing/webpack.mix.js watch -- --watch-options-poll=1000",
        "marketing-hot": "mix --mix-config=resources/marketing/webpack.mix.js watch --hot",
        "mw": "mix --mix-config=resources/marketing/webpack.mix.js watch",
        "md": "mix --mix-config=resources/marketing/webpack.mix.js",
        "mp": "mix --mix-config=resources/marketing/webpack.mix.js --production",
        "mrkd": "parcel build resources/marketing/assets/parcel/drumeo/*.js --dist-dir public/marketing/parcel/drumeo --no-cache --log-level verbose",
        "mrkp": "parcel build resources/marketing/assets/parcel/pianote/*.js --dist-dir public/marketing/parcel/pianote --no-cache --log-level verbose",
        "mrkg": "parcel build resources/marketing/assets/parcel/guitareo/*.js --dist-dir public/marketing/parcel/guitareo --no-cache --log-level verbose",
        "mrks": "parcel build resources/marketing/assets/parcel/singeo/*.js --dist-dir public/marketing/parcel/singeo --no-cache --log-level verbose"
    },
    "devDependencies": {
        "@heroicons/vue": "^1.0.5",
        "@parcel/transformer-sass": "^2.7.0",
        "@tailwindcss/aspect-ratio": "^0.4.0",
        "@tailwindcss/forms": "^0.5.0",
        "@tailwindcss/line-clamp": "^0.4.0",
        "@tailwindcss/typography": "^0.5.2",
        "autoprefixer": "^10.3.7",
        "eslint": "^8.8.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^4.0.0",
        "laravel-mix": "^6.0.43",
        "laravel-mix-merge-manifest": "^2.0.0",
        "postcss": "^8.3.9",
        "prettier": "^2.5.1",
        "prettier-plugin-tailwindcss": "^0.1.4",
        "resolve-url-loader": "^4.0.0",
        "sass": "^1.49.9",
        "sass-loader": "^12.1.0",
        "stylesora": "^1.0.102",
        "tailwindcss": "^3.0.23",
        "vue-recaptcha": "^2.0.2"
    },
    "dependencies": {
        "@musora/icons": "^1.0.6",
        "@tinymce/tinymce-vue": "^5.0.0",
        "@vimeo/player": "^2.15.0",
        "alpinejs": "^3.4.2",
        "ansi-styles": "^6.1.0",
        "axios": "^0.26.1",
        "cropperjs": "^1.5.12",
        "dropzone": "5.7.2",
        "fast-glob": "^3.2.11",
        "flatpickr": "^4.6.13",
        "imgix-core-js": "^2.3.2",
        "laravel-vapor": "^0.6.0",
        "lodash": "^4.17.19",
