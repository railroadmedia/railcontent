{
    "engines": {
        "node": ">=16.0.0"
    },
    "private": true,
    "scripts": {
        "platform-development": "mix --mix-config=resources/platform/webpack.mix.js",
        "platform-production": " npx mix --mix-config=resources/platform/webpack.mix.js --production",
        "platform-watch": "npx mix --mix-config=resources/platform/webpack.mix.js watch",
        "platform-watch-poll": "mix --mix-config=resources/platform/webpack.mix.js watch -- --watch-options-poll=1000",
        "platform-hot": "mix --mix-config=resources/platform/webpack.mix.js watch --hot",
        "pd": "yarn platform-development",
        "pp": "yarn platform-production",
        "pw": "yarn platform-watch",
        "marketing-production": "parcel build resources/marketing/assets/parcel/scss/* --dist-dir public/marketing/parcel/drumeo --no-cache --log-level verbose",
        "mp": "yarn marketing-production",
        "mjs": "parcel build resources/marketing/assets/parcel/js/* --dist-dir public/marketing/parcel/drumeo --no-cache --log-level verbose",
        "prepare": "husky install"
    },
    "devDependencies": {
        "@heroicons/vue": "^1.0.5",
        "@parcel/transformer-vue": "2.7.0",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/forms": "^0.5.0",
        "@tailwindcss/line-clamp": "^0.4.0",
        "@tailwindcss/typography": "^0.5.2",
        "autoprefixer": "^10.3.7",
        "eslint": "^8.8.0",
        "eslint-config-prettier": "^8.3.0",
        "eslint-plugin-prettier": "^4.0.0",
        "laravel-mix": "^6.0.43",
        "postcss": "^8.3.9",
        "postcss-import": "^15.0.0",
        "prettier": "^2.5.1",
        "prettier-plugin-tailwindcss": "^0.1.4",
        "resolve-url-loader": "^4.0.0",
        "sass": "^1.49.9",
        "sass-loader": "^12.1.0",
        "tailwindcss": "^3.3.6",
        "vue-recaptcha": "^2.0.2",
        "husky": "^8.0.0"
    },
    "dependencies": {
        "@babel/preset-env": "^7.22.10",
        "@babel/preset-react": "^7.22.5",
        "@musora/icons": "^1.0.6",
        "@parcel/transformer-sass": "^2.7.0",
        "@tinymce/tinymce-vue": "^5.1.1",
        "@vimeo/player": "^2.15.0",
        "alpinejs": "^3.4.2",
        "ansi-styles": "^6.1.0",
        "axios": "^0.26.1",
        "babel-loader": "^9.1.3",
        "cropperjs": "^1.5.12",
        "dropzone": "5.7.2",
        "fast-glob": "^3.2.11",
        "flatpickr": "^4.6.13",
        "imgix-core-js": "^2.3.2",
        "laravel-vapor": "^0.6.0",
        "linkifyjs": "^3.0.0-beta.3",
        "lodash": "^4.17.19",
        "luxon": "^3.0.1",
        "maska": "^2.1.6",
        "mediaelement": "^7.0.2",
        "mediaelement-plugins": "^2.6.7",
        "mitt": "^3.0.0",
        "mux.js": "^5.5.1",
        "normalize.css": "^8.0.1",
        "noty": "^3.2.0-beta-deprecated",
        "parcel": "^2.7.0",
        "pinia": "^2.1.7",
        "query-string": "^7.1.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
