{
  "engines": {
    "node": ">=16.0.0"
  },
  "private": true,
  "scripts": {
    "platform-development": "mix --mix-config=resources/platform/webpack.mix.js",
    "platform-production": " npx mix --mix-config=resources/platform/webpack.mix.js --production",
    "platform-watch": "npx mix --mix-config=resources/platform/webpack.mix.js watch",
    "platform-watch-poll": "mix --mix-config=resources/platform/webpack.mix.js watch -- --watch-options-poll=1000",
    "platform-hot": "mix --mix-config=resources/platform/webpack.mix.js watch --hot",
    "pd": "yarn platform-development",
    "pp": "yarn platform-production",
    "pw": "yarn platform-watch",
    "marketing-production": "parcel build resources/marketing/assets/parcel/scss/* --dist-dir public/marketing/parcel/drumeo --no-cache --log-level verbose && parcel build resources/marketing/assets/parcel/js/* --dist-dir public/marketing/parcel/drumeo --no-cache --log-level verbose",
    "mp": "yarn marketing-production",
    "run-storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o public/storybook-build",
    "test:unit": "jest"
  },
