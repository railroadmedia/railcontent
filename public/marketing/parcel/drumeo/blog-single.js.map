$(document).ready(function($1) {
    var clipboard = new ClipboardJS("#copyClipboard");
    clipboard.on("success", function(e) {
        document.getElementById("copyClipboard").className += "active";
    });
    function resizeIframes() {
        $1("iframe").each(function() {
            var ratio = $1(this).attr("height") / $1(this).attr("width");
            $1(this).css("height", $1(this).width() * ratio);
        });
    }
    resizeIframes();
    $1(window).resize(function() {
        if (!$1(".white-box.Videos").find("p:nth-child(2)").hasClass("sticky-vid")) resizeIframes();
    });
    if ($1(".white-box").hasClass("Videos")) $1(".post-ad-content").insertAfter($1(".white-box > p:nth-child(3)")).removeClass("hide");
    else $1(".post-ad-content").insertAfter($1(".white-box > p:nth-child(1)")).removeClass("hide");
    if ($1(".white-box.Videos").find("iframe").length < 2) {
        var mainVideo = $1(".white-box > p:nth-child(2) > iframe");
        setTimeout(function() {
            mainVideo.attr("src", mainVideo.data("src") + "?playsinline=1");
        }, 50);
        var iframePtag = $1(".white-box.Videos").find("p:nth-child(2)");
        var fixedVideoPadding = $1(".video-buffer");
        $1(".close-sticky").on("click", function() {
            iframePtag.removeClass("active");
            fixedVideoPadding.removeClass("active");
        });
        if ($1(".white-box").height() > 1500) {
            $1(window).blur(function() {
                if ($1("iframe:focus")) $1(iframePtag).addClass("active");
            });
            // var hasFocus = false;
            //
            // $('iframe').on('focus', function () {
            //     console.log('ready');
            //     hasFocus = true;
            // });
            // $(window).blur(function () {
            //     if (hasFocus) {
            //         $(iframePtag).addClass('active');
            //     }
            // });
            $1(window).scroll(function() {
                var tagAfterIframe = $1(".white-box").find("p:nth-of-type(2)").offset().top;
                if ($1(this).scrollTop() > tagAfterIframe - 100 && iframePtag.hasClass("active")) {
                    iframePtag.addClass("sticky-vid");
                    fixedVideoPadding.addClass("active");
                }
                if ($1(this).scrollTop() < tagAfterIframe - 100) {
                    iframePtag.removeClass("sticky-vid");
                    fixedVideoPadding.removeClass("active");
                }
            });
        }
    }
    const whiteBox = document.querySelector(".white-box");
    const thirdElement = whiteBox.children[2];
