{
  "name": "railroad/railcontent",
  "type": "library",
  "description": "Very simple and flexible CMS system for developers.",
  "keywords": [
    "cms",
    "developer",
    "railcontent"
  ],
  "license": "MIT",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "guzzlehttp/guzzle": "^7.2",
    "doctrine/dbal": "^4.0",
    "ramsey/uuid": "^4.3",
    "aws/aws-sdk-php": "^3.0.0",
    "league/flysystem": "^3.0",
    "league/flysystem-aws-s3-v3": "^3.0",
    "vimeo/vimeo-api": "^3.0",
    "predis/predis": "^2.1",
    "google/apiclient": "^2.2",
    "railroad/response": "^3.0",
    "railroad/mailora": "^4.0",
    "symfony/http-foundation": "^7.0",
    "elasticsearch/elasticsearch": "~7.0",
    "ext-pdo": "*",
    "iksaku/laravel-mass-update": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "classmap": [
      "database/seeds"
    ],
    "psr-4": {
      "Railroad\\Railcontent\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\Railcontent\\Tests\\": "tests/"
    },
    "classmap": [
      "tests/RailcontentProvider.php"
    ]
  }
}
