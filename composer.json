{
    "name": "railroad/musora-web-platform",
    "type": "project",
    "description": "Musora's platform.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-openssl": "*",
        "cweagans/composer-patches": "^1.7",
        "fakerphp/faker": "^1.23",
        "giggsey/libphonenumber-for-php": "^8.13",
        "guzzlehttp/guzzle": "^7.8",
        "iksaku/laravel-mass-update": "^1.0",
        "intervention/image": "^2.7",
        "jenssegers/agent": "^2.6",
        "laravel/framework": "^11.20",
        "laravel/nova": "^4.3",
        "laravel/sanctum": "^4.0",
        "laravel/tinker": "^2.9",
        "laravel/vapor-cli": "^1.63",
        "laravel/vapor-core": "^2.36",
        "league/flysystem-aws-s3-v3": "^3.0",
        "railroad/doctrine-array-hydrator": "v3.0.*",
        "railroad/ecommerce": "6.0.*",
        "railroad/lead-tracker": "4.0.*",
        "railroad/location": "4.0.*",
        "railroad/mailora": "4.0.*",
        "railroad/musora-api": "4.0.*",
        "railroad/points": "2.0.*",
        "railroad/railanalytics": "4.0.*",
        "railroad/railchat": "3.0.*",
        "railroad/railcontent": "v3.0.*",
        "railroad/railforums": "3.0.*",
        "railroad/railnotifications": "4.0.*",
        "railroad/railtracker": "5.0.*",
        "railroad/referral": "4.0.*",
        "railroad/usora": "4.0.*",
        "railroadmedia/helpscout-api-php": "~3.7",
        "rudderstack/rudder-php-sdk": "*",
        "sanity/sanity-php": "^1.5",
        "sentry/sentry-laravel": "^4.5",
        "shopify/shopify-api": "^5.1",
        "signifly/laravel-shopify": "dev-master",
        "spatie/laravel-data": "^4.1",
        "spatie/laravel-markdown": "^2.4",
        "spatie/laravel-permission": "^6.2",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0",
        "venturecraft/revisionable": "^1.41",
        "vimeo/vimeo-api": "^3.0",
        "whitecube/nova-flexible-content": "^1.1",
        "lcobucci/clock": "^3.2",
        "symfony/css-selector": "^7.0",
        "symfony/options-resolver": "^7.0",
        "symfony/psr-http-message-bridge": "6.4.*",
        "symfony/string": "^7.0",
        "symfony/var-exporter": "^7.0",
        "symfony/filesystem": "^7.0",
        "symfony/stopwatch": "^7.0",
        "google/apiclient": "^2.12",
        "google/auth": "^1.10"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.10",
        "barryvdh/laravel-ide-helper": "^3.0",
        "brianium/paratest": "^7.4",
        "fakerphp/faker": "^1.9.1",
        "friendsofphp/php-cs-fixer": "^3.51",
        "kitloong/laravel-migrations-generator": "^7.0",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5",
        "reliese/laravel": "^1.3",
        "ext-pdo": "*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "Modules\\": "app/Modules",
            "Modules\\UserManagementSystem\\Factories\\": "app/Modules/UserManagementSystem/database/factories",
            "Laravel\\Vapor\\Runtime\\": "app/VaporCoreClassOverrides"
        },
        "files": [
            "helpers/helpers.php",
            "app/Modules/UserManagementSystem/helpers/user_management_system_helpers.php",
            "app/Modules/Brand/helpers/brand_helpers.php",
            "app/Modules/Brand/helpers/prices.php",
            "app/Modules/EventTracking/Avo/Avo.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Modules\\UserManagementSystem\\Tests\\": "app/Modules/UserManagementSystem/tests",
            "Modules\\Brand\\Tests\\": "app/Modules/Brand/tests"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "@php -d memory_limit=-1 artisan test --stop-on-failure --stop-on-error",
        "test-p": "@php -d memory_limit=-1 artisan test --parallel --stop-on-failure --stop-on-error",
        "test-cov-p": [
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=-1 -d opcache.enable_cli=1 artisan test --coverage --parallel --stop-on-failure --stop-on-error"
        ],
        "test-cov-html-p": [
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=-1 -d opcache.enable_cli=1 artisan test --parallel --stop-on-failure --stop-on-error --coverage-html reports/"
        ],
        "test-cov": [
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=-1 -d opcache.enable_cli=1 artisan test --coverage"
        ],
        "test-cov-html": [
            "@putenv XDEBUG_MODE=coverage",
            "@php -d memory_limit=-1 -d opcache.enable_cli=1 artisan test --coverage-html reports/"
        ],
        "cs-fixer-dry": [
            "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php -vvv --dry-run --show-progress=dots"
        ],
        "cs-fixer-fix": [
            "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.php -vvv --show-progress=dots"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "composer-exit-on-patch-failure": true,
        "patches": {
            "signifly/laravel-shopify": {
                "Fix adjustInventoryLevel response": "patches/composer/laravel-shopify/fix-adjustInventoryLevel.patch",
                "Fix updateCustomerAddress to use proper response key": "patches/composer/laravel-shopify/fix-updateCustomerAddress.patch"
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
